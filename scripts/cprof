#!/usr/bin/env bash
set -u

CP_VERSION='0.6.1'

# Follow symlinks to the real file before looking for lib/ beside it. $0 is the
# path used to invoke, not the file invoked: a Homebrew install links bin/cprof
# at libexec, and people run `ln -s` by hand, and in both cases the invoking
# directory holds no lib/. Getting this wrong is not a missing-feature failure —
# the branch below prints `unset CLAUDE_CONFIG_DIR` on stdout, which the shell
# function evals, so the session would quietly run the wrong account.
#
# readlink without -f: the flag is a GNU extension that older macOS lacks.
CP_SELF="${BASH_SOURCE[0]}"
while [ -L "$CP_SELF" ]; do
  CP_LINK="$(readlink "$CP_SELF")"
  case "$CP_LINK" in
    /*) CP_SELF="$CP_LINK" ;;
    *)  CP_SELF="$(dirname "$CP_SELF")/$CP_LINK" ;;
  esac
done
CP_LIB_DIR="$(cd "$(dirname "$CP_SELF")/lib" 2>/dev/null && pwd -P)"
unset CP_SELF CP_LINK
if [ -z "$CP_LIB_DIR" ]; then
  printf 'unset CLAUDE_CONFIG_DIR\n'
  printf 'cprof: cannot locate lib directory\n' >&2
  exit 0
fi
# shellcheck source=lib/config.sh
. "$CP_LIB_DIR/config.sh"
# shellcheck source=lib/resolve.sh
. "$CP_LIB_DIR/resolve.sh"
# shellcheck source=lib/profiles.sh
. "$CP_LIB_DIR/profiles.sh"
# shellcheck source=lib/auth.sh
. "$CP_LIB_DIR/auth.sh"
# shellcheck source=lib/output.sh
. "$CP_LIB_DIR/output.sh"
# shellcheck source=lib/color.sh
. "$CP_LIB_DIR/color.sh"
# shellcheck source=lib/share.sh
. "$CP_LIB_DIR/share.sh"

cp_usage() {
  cat >&2 <<'USAGE'
cprof - choose which Claude account a session uses

usage:
  cprof list                       profiles, identities, markers
  cprof which                      profile resolved for this directory
  cprof status                     profile this process is running as
  cprof env                        export statements for eval
  cprof add <name> [--dir P] [--native] [--note S] [--isolated]
  cprof share <name>               plugins, skills, settings from ~/.claude
  cprof unshare <name>             drop those links
  cprof color <name> [<colour>]    pick or set a profile's colour
  cprof color <name> auto          back to the hashed colour
  cprof color --text on|off        colour the name as well as the flag
  cprof color --render <name>      SGR parameter and colorText, tab-separated
                                    (what the statusline segment calls)
  cprof default <name>
  cprof pin [<name>] | pin --clear
  cprof rules                      rules in the order they are consulted
  cprof rule add <path> <name> | rule rm <path> | rule list
  cprof login <name>
  cprof doctor
  cprof remove <name> [--purge]
  cprof version

shell setup (~/.zshrc):
  claude() { eval "$(cprof env)"; command claude "$@"; }
USAGE
}

cmd="${1:-}"
[ "$#" -gt 0 ] && shift

case "$cmd" in
  env)     cp_cmd_env; exit 0 ;;
  which)   cp_cmd_which ;;
  status)  cp_cmd_status ;;
  list)    cp_cmd_list "$@" ;;
  add)     cp_cmd_add "$@" ;;
  default) cp_cmd_default "$@" ;;
  pin)     cp_cmd_pin "$@" ;;
  rule)    cp_cmd_rule "$@" ;;
  rules)   cp_cmd_rule list ;;
  share)   cp_cmd_share "$@" ;;
  unshare) cp_cmd_unshare "$@" ;;
  color)   cp_cmd_color "$@" ;;
  login)   cp_cmd_login "$@" ;;
  doctor)  cp_cmd_doctor "$@" ;;
  remove)  cp_cmd_remove "$@" ;;
  version|--version|-v) printf 'cprof %s\n' "$CP_VERSION" ;;
  help|--help|-h) cp_usage ;;
  *)       cp_usage; exit 2 ;;
esac
