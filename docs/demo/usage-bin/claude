#!/usr/bin/env bash
# Demo stub: `claude auth status --json` for the usage GIF, keyed on the
# profile directory cprof asks about.
# Only the call cprof actually makes; anything else means the fixture drifted.
[ "$#" -eq 3 ] && [ "$1" = auth ] && [ "$2" = status ] && [ "$3" = --json ] || exit 1
case "${CLAUDE_CONFIG_DIR:-}" in
  */personal) printf '{"loggedIn":true,"email":"you@personal.dev","subscriptionType":"max"}\n' ;;
  *)          printf '{"loggedIn":true,"email":"you@acme.com","subscriptionType":"team"}\n' ;;
esac
